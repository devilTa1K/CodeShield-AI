# Copy to backend/.env (or to the repo root as .env) and fill in. Never commit the real file.

# --- BharatCode API (required for AI analysis) -------------------------------
# Create a key at https://bharatcode.ai. Without it the app still runs, using
# static analysis only, and clearly says that AI analysis is disabled.
BHARATCODE_API_KEY=paste your bharatcode api here

# Defaults shown; change only if the official BharatCode docs say otherwise.
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_TIMEOUT_SECONDS=90
BHARATCODE_MAX_OUTPUT_TOKENS=6000
BHARATCODE_MAX_RETRIES=2

# --- Limits ---------------------------------------------------------------------
MAX_CODE_CHARS=40000
MAX_CODE_LINES=1500
RATE_LIMIT_PER_MINUTE=20

# --- Server -----------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Optional scanners ----------------------------------------------------------
SCANNER_TIMEOUT_SECONDS=30
# Semgrep runs only if the `semgrep` CLI is installed AND this is set to a local
# rules file/directory (or a registry config such as p/security-audit, which needs
# network access from the server).
SEMGREP_CONFIG=
